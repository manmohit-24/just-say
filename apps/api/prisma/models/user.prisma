enum UserStatus {
  UNVERIFIED
  ACTIVE
  DEACTIVATED
  DELETION_SCHEDULED
}

model User {
  id       String @id @default(cuid())
  publicId String @unique

  name         String
  username     String @unique
  email        String @unique
  passwordHash String

  isAcceptingMessages Boolean @default(true)

  status              UserStatus @default(UNVERIFIED)
  deletionScheduledAt DateTime?

  // Activation state is kept in PostgreSQL because it is tied to the user's
  // durable UNVERIFIED account state. Unlike short-lived Redis workflows such
  // as password reset, activation must remain recoverable even if Redis data
  // is lost or unavailable.

  activationTokenHash      String?   @unique
  activationTokenExpiresAt DateTime?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
