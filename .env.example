# Environment
NODE_ENV=development

# Ports
API_PORT=3001
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000

# Database
# Docker compose connection :
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=just_say

# Local development connection
DATABASE_URL=postgresql://username:password@localhost:5432/just_say

# Redis

# Local development connection
REDIS_URL=redis://localhost:6379

# Authentication
ACCESS_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_TTL=30d

# AI
GOOGLE_GENERATIVE_AI_API_KEY=there-go-your-gemini-api-key

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=there-go-the-@email.com
SMTP_PASSWORD=smpt-password
